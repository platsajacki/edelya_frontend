{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "useUnknownInCatchVariables": false,
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "include": ["."],
  "exclude": ["dist", "build", "node_modules"]
}
